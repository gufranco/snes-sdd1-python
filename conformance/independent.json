  "authored": {
    "what": "Seven further streams from the same package that ship with no counterpart beside them, six of them content the author wrote rather than content the cartridge holds.",
    "why": "The twenty pairs are a round trip inside one toolchain: the author's encoder out, this decoder back. These ask a different question, because one of them is an unmodified export of data the retail cartridge also carries. Decoding that one here and decoding the cartridge's own stream here must reach the same bytes, and the modified siblings beside it must not, which is the control that makes the agreement mean something.",
    "positiveControl": {
      "name": "vs results us names original",
      "retailStreamAt": "0x1AB82E",
      "retailDeclaredBytes": 2048,
      "agreedBytes": 2016,
      "outcome": "identical over every byte the author's export carries",
      "shortByAuthor": 32
    },
    "negativeControl": {
      "names": [
        "vs results us names +sodom",
        "vs results us names +nash +sodom",
        "vs results japanese names"
      ],
      "outcome": "none matches any stream in either cartridge",
      "why": "They are the same screen with names changed, so a match would have meant the comparison was insensitive to content."
    },
    "aboutTheShortOne": "The matching export stops thirty two bytes before the cartridge's own stream declares, and every byte it does carry agrees. That is the same shortfall the twenty pairs show at sixty four bytes, from the same author's export step, and it is left uncorrected here for the same reason.",
